{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "webfetch": "deny",
    "bash": {
      "*": "deny",
      "scripts/generate.sh *": "allow",
      "./scripts/generate.sh *": "allow",
      "sh scripts/generate.sh *": "allow",
      "uv run *": "allow",
      "sips *": "allow",
      "file *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "cat *": "allow",
      "mkdir *": "allow"
    }
  }
}
