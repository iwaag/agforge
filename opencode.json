{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "options": {
        "baseURL": "{env:AGENT_PROVIDER_OLLAMA_BASE_URL}"
      }
    }
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "todowrite": "allow",
    "lsp": "allow",
    "skill": "allow",
    "external_directory": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "bash": {
      "*": "deny",
      "scripts/generate.sh *": "allow",
      "./scripts/generate.sh *": "allow",
      "sh scripts/generate.sh *": "allow",
      "uv *": "allow",
      "python3 *": "allow",
      "pip *": "allow",
      "curl *": "allow",
      "sips *": "allow",
      "magick *": "allow",
      "ffmpeg *": "allow",
      "ffprobe *": "allow",
      "file *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "cd *": "allow",
      "mkdir *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "rm *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "sed *": "allow",
      "awk *": "allow",
      "echo *": "allow",
      "printf *": "allow",
      "jq *": "allow",
      "date *": "allow",
      "env": "allow",
      "env *": "allow",
      "which *": "allow",
      "mc *": "allow",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git show*": "allow"
    }
  }
}
